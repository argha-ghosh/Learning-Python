# Steepest Ascent Hill Climbing
def steepest_hill(start):
    x = start

    while True:
        left = x - 1
        right = x + 1

        best = x
        if f(left) > f(best):
            best = left
        if f(right) > f(best):
            best = right

        if best == x:
            break

        x = best

    return x


